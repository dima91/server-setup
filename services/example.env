# =============================================================================
# Esempio di configurazione per server-setup/services (deploy su server).
# Copia questo file in .env, personalizza i valori con i tuoi dati reali e
# lascialo nella cartella prima di eseguire setup.sh (o "docker compose up -d").
#
# Per lo sviluppo locale non serve copiare/editare nulla: usa il file
# .env.local già pronto, ad es.:
#   docker compose --env-file .env.local up -d
# =============================================================================

# Dominio di base usato per i domini NPM (proxy hosts).
SERVER_DOMAIN=example.com

# Profili dei servizi opzionali, separati da virgola. Rimuovi un profilo
# per disattivare quel gruppo (npm e npm-db restano sempre attivi):
#   server     -> VPN, CrowdSec, Bouncer
#   portainer  -> Portainer + init
#   ai         -> Ollama, ollama-init, Open WebUI
#   COMPOSE_PROFILES=server,portainer,ai  -> stack completo (default su VPS)
#   COMPOSE_PROFILES=                     -> solo NPM (vedi anche .env.local)
COMPOSE_PROFILES=server,portainer,ai

# Provider certificato NPM:
#   letsencrypt -> produzione, richiede dominio pubblico raggiungibile
#   local       -> self-signed, solo sviluppo (vedi .env.local)
NPM_CERT_PROVIDER=letsencrypt

# --- NPM (Nginx Proxy Manager) ---
NPM_DB_USER=npm
NPM_DB_PASSWORD=change_me_npm_db_password
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change_me_npm_admin_password

# --- Portainer ---
PORTAINER_ADMIN_USERNAME=portainer_admin
PORTAINER_ADMIN_PASSWORD=change_me_portainer_password
PORTAINER_SETUP_TOKEN=change_me_portainer_setup_token

# --- Open WebUI ---
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change_me_webui_password
WEBUI_ADMIN_NAME=webui_admin

# Tag immagine Open WebUI. Rolling di default; puoi pinnare una versione
# per riproducibilità, es. v0.11.0.
OPEN_WEBUI_TAG=main

# --- CrowdSec (solo con COMPOSE_PROFILES=server) ---
# Viene generata automaticamente da setup.sh su server.
CROWDSEC_BOUNCER_API_KEY=bouncer_api_key
