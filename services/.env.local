# =============================================================================
# Configurazione pronta per lo sviluppo locale. Nessuna modifica richiesta.
#
# Uso:
#   docker compose --env-file .env.local up -d
#
# Rispetto a .env (server): certificato NPM self-signed, VPN/CrowdSec/Bouncer
# disattivati (profilo "server" escluso) e dominio locale via nip.io, che
# risolve *.127.0.0.1.nip.io a 127.0.0.1 senza toccare /etc/hosts.
# =============================================================================

SERVER_DOMAIN=127.0.0.1.nip.io

# Portainer e stack AI (Ollama/Open WebUI) attivi per testare in locale;
# profilo "server" (VPN/CrowdSec/Bouncer) escluso.
COMPOSE_PROFILES=portainer

NPM_CERT_PROVIDER=local

# --- NPM (Nginx Proxy Manager) ---
NPM_DB_USER=npm
NPM_DB_PASSWORD=local_npm_db_password
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=local_npm_admin_password

# --- Portainer ---
PORTAINER_ADMIN_USERNAME=portainer_admin
PORTAINER_ADMIN_PASSWORD=local_portainer_password
PORTAINER_SETUP_TOKEN=local_portainer_setup_token

# --- Open WebUI ---
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=local_webui_password
WEBUI_ADMIN_NAME=webui_admin

OPEN_WEBUI_TAG=main

# Non usata in locale (crowdsec/cs-bouncer sono nel profilo "server"): valore
# fittizio solo per evitare il warning "variable is not set" di Compose.
CROWDSEC_BOUNCER_API_KEY=unused-locally
